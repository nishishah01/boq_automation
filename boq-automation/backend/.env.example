# PostgreSQL is the production database. Leave unset to use local SQLite for development.
# DATABASE_URL=postgresql+psycopg2://boq:boq@localhost:5432/boq
STORAGE_DIR=./data/storage

# Leave empty to run in rule-based (mock) mode. Never expose this key to the frontend.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Which provider "auto" uses: anthropic | openai | gemini. Set that provider's key below.
AI_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# auto = the AI_PROVIDER's model when its key is set, otherwise rule-based.
# Or force one: claude | openai | gemini | mock
AI_MODE=auto

# lsa = offline TF-IDF + SVD embeddings. sentence-transformers = neural (downloads a model)
EMBEDDING_BACKEND=lsa
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Add "Lowside Supply,Lowside Installation" here to extend scope; no code change needed.
ENABLED_COST_SHEET_TYPES=Highside Supply,Highside Installation
CORS_ORIGINS=http://localhost:5173
